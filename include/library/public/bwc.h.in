#ifndef BWC_H
#define BWC_H
  /*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*\
  ||                                _ _  _ ____ _    _  _ ___  ____                               ||
  ||                                | |\ | |    |    |  | |  \ |___                               ||
  ||                                | | \| |___ |___ |__| |__/ |___                               ||
  ||                                                                                              ||
  \*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*/
  #include <stdio.h>
  #include <stdint.h>

  /*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*\
  ||                ___  ____ _ _  _ _ ___ _ _  _ ____    ___ _   _ ___  ____ ____                ||
  ||                |__] |__/ | |\/| |  |  | |  | |___     |   \_/  |__] |___ [__                 ||
  ||                |    |  \ | |  | |  |  |  \/  |___     |    |   |    |___ ___]                ||
  ||                                                                                              ||
  \*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*/
  typedef unsigned char         uchar;
  typedef unsigned short        ushort;
  typedef unsigned int          uint;

  typedef int8_t                int8;
  typedef uint8_t               uint8;
  typedef int16_t               int16;
  typedef uint16_t              uint16;
  typedef int32_t               int32;
  typedef uint32_t              uint32;
  typedef int64_t               int64;
  typedef uint64_t              uint64;

  @BWC_PRECISION_TYPE_BLOCK@

  /*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*\
  ||                                 _  _ ____ ____ ____ ____ ____                                ||
  ||                                 |\/| |__| |    |__/ |  | [__                                 ||
  ||                                 |  | |  | |___ |  \ |__| ___]                                ||
  ||                                                                                              ||
  \*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*/
  @BWC_PRECISION_MACRO_BLOCK@

  #define BWC_VERSION_MAJOR     @BWC_VERSION_MAJOR@ 
  #define BWC_VERSION_MINOR     @BWC_VERSION_MINOR@
  #define BWC_VERSION_PATCH     @BWC_VERSION_PATCH@

  /*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*\
  ||                          ____ ____ _  _ ____ ___ ____ _  _ ___ ____                          ||
  ||                          |    |  | |\ | [__   |  |__| |\ |  |  [__                           ||
  ||                          |___ |__| | \| ___]  |  |  | | \|  |  ___]                          ||
  ||                                                                                              ||
  \*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*/
  typedef enum
  {
    bwc_dwt_9_7,
    bwc_dwt_5_3,
    bwc_dwt_haar
  } bwc_dwt_filter;
  /*==============================================================================================*/
  typedef enum
  {
    bwc_prog_LRCP,
    bwc_prog_RLCP,
    bwc_prog_RPCL,
    bwc_prog_PCRL,
    bwc_prog_CPRL
  } bwc_prog_ord;
  /*==============================================================================================*/
  typedef enum
  {
    bwc_qt_none,
    bwc_qt_derived,
  } bwc_quant_st;
  /*==============================================================================================*/
  typedef enum
  {
    bwc_tile_sizeof,
    bwc_tile_numbof,
  } bwc_tile_instr;
  /*==============================================================================================*/
  typedef enum
  {
    bwc_precision_half = 2,
    bwc_precision_single = 4,
    bwc_precision_double = 8,
  } bwc_precision;
  /*==============================================================================================*/
  typedef enum
  {
    comp,
    decomp,
  } bwc_mode;

  /*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*\
  ||               ___  ____ ____ ____ _ _  _ ____ ___     ___ _   _ ___  ____ ____               ||
  ||               |  \ |___ |__/ |__/ | |  | |___ |  \     |   \_/  |__] |___ [__                ||
  ||               |__/ |___ |  \ |  \ |  \/  |___ |__/     |    |   |    |___ ___]               ||
  ||                                                                                              ||
  \*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*/
  typedef struct context
  {
    uint16_t                    p;
    uint8_t                     sk;

    const struct context *const MPS;
    const struct context *const LPS;
  } bwc_context_state;
  /*==============================================================================================*/
  typedef struct state
  {
    int64_t                     L;
    uint32_t                    C;
    uint16_t                    A;
    int8_t                      t;

    unsigned char              *b;
    unsigned char               T;

    struct state               *next;
    struct state               *prev;
  } bwc_coder_state;
  /*==============================================================================================*/
  typedef struct
  {
    int64_t                     Lmax;
    uint8_t                     nContext;

    unsigned char              *b;

    bwc_coder_state            *state;
    bwc_context_state const   **context;
  } bwc_bit_coder;
  /*==============================================================================================*/
  typedef struct stripe
  {
    uint64                     *sample;

    uint8                       delta;
    uint8                       sigma;
    uint8                       pi;

    uint8                       codingpass;

    uint8                       bitplane;
    uint8                      *bit;
    uint8                       xi;

    struct stripe              *stripe_u;
    struct stripe              *stripe_r;
    struct stripe              *stripe_d;
    struct stripe              *stripe_l;
  } bwc_coder_stripe;
  /*==============================================================================================*/
  typedef struct
  {
    uchar                       highband_flag;
    uint8                       K;
    uchar                       erres;

    uint64                      no_full_stripe;
    uint64                      width, height;
    uint64                      no_slice;

    uint8                const *sig2context;
    bwc_bit_coder              *bitcoder;

    bwc_coder_stripe           *data;

    uint64                      buff_size;
    uint64                      buff_incr;
    uchar                      *compressed;
  } bwc_coder;
  /*==============================================================================================*/
  typedef union
  {
    bwc_raw                     raw;
    bwc_float                   f;
  } bwc_sample;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      size;
    uint64                      position;

    uchar                      *access;
    uchar                      *memory;
  } bwc_span;
  /*==============================================================================================*/
  typedef struct node
  {
    uint64                      index;

    uint16                      value;
    uint16                      threshold;

    struct node*                parent;
  } bwc_tagtree_node;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      leavesX, leavesY;
    uint64                      leavesZ, leavesTS;

    bwc_tagtree_node           *nodes;
  } bwc_tagtree;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      nX, nY, nZ;
    uint64                      nTS;

    uint8                       nPar;

    bwc_precision               data_prec;
    bwc_precision               codec_prec;
  } bwc_gl_inf;
  /*==============================================================================================*/
  typedef struct
  {
    struct codestream
    {
      bwc_span                 *aux;
      bwc_span                 *com;
    }codestream;

    void                       *inp;
    void                       *out;

    bwc_mode                    mode;
  } bwc_stream;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      L[MAXIMUM_NO_PASSES];
    uint16                      S[MAXIMUM_NO_PASSES + 1];

    uint8                       Kmsbs;
    uint8                       K;

    uint8                       Z;

    uchar                      *data;
  } bwc_encoded_cblk;
  /*==============================================================================================*/
  typedef struct
  {
    uint16                      beta;
    uint16                      beta_est;

    uint16                      K;

    int16                      *memory;
    int16                      *cp_contr;
  } bwc_cblk_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    uint32                      idx;

    uint64                      X0, Y0, Z0, TS0;
    uint64                      X1, Y1, Z1, TS1;
  } bwc_cblk_inf;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_cblk_inf                info;
    bwc_cblk_ctrl               control;
    bwc_encoded_cblk           *encoded_block;
  } bwc_codeblock;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      number_of_codeblocks;

    uint16                      numCbX, numCbY;
    uint16                      numCbZ, numCbTS;

    bwc_tagtree                *tag_inclusion;
    bwc_tagtree                *tag_msbs;
  } bwc_prec_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    uint32                      X0, Y0, Z0, TS0;
    uint32                      X1, Y1, Z1, TS1;
  } bwc_prec_inf;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_prec_inf                info;
    bwc_prec_ctrl               control;
    bwc_codeblock              *codeblock;
  } bwc_precinct;
  /*==============================================================================================*/
  typedef struct
  {
    uchar                       highband_flag;

    uint16                      Kmax;

    uint16                      qt_mantissa;
    uint8                       qt_exponent;

    bwc_float                   qt_effective_step_size;
    bwc_float                   qt_step_size;
  } bwc_subb_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      X0, Y0, Z0, TS0;
    uint64                      X1, Y1, Z1, TS1;

    bwc_float                   dwt_gain;
  } bwc_subb_inf;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_subb_inf                info;
    bwc_subb_ctrl               control;

    bwc_precinct               *precinct;
  } bwc_subband;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_span                    header;
    bwc_span                    body;
    uint8                       e;

    uint32                      size;

    uint32                      p;
    uint8                       c, l, r;

  } bwc_packet;
  /*==============================================================================================*/
  typedef struct
  {
    uint16                      numPX, numPY, numPZ;
    uint16                      numPTS;

    uint8                       rcbX,  rcbY, rcbZ;
    uint8                       rcbTS;

    uint64                      number_of_precincts;
    uint8                       number_of_subbands;
  } bwc_res_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      X0, Y0, Z0, TS0;
    uint64                      X1, Y1, Z1, TS1;
  } bwc_res_inf;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_res_inf                 info;
    bwc_res_ctrl                control;

    bwc_subband                *subband;
    bwc_packet                 *packet;
  } bwc_resolution;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_codeblock              *codeblock;
    bwc_precinct               *precinct;
    bwc_subband                *subband;
  } bwc_cblk_access;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      number_of_codeblocks;
    bwc_float                   alpha, beta;
  } bwc_param_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      X0, Y0, Z0, TS0;
    uint64                      X1, Y1, Z1, TS1;

    bwc_float                   parameter_min;
    bwc_float                   parameter_max;
  } bwc_param_inf;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      size;
    bwc_sample                  *data;

    bwc_param_inf               info;
    bwc_param_ctrl              control;

    bwc_resolution             *resolution;

    bwc_cblk_access            *access;
  } bwc_parameter;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      body_size;
    uint64                      Ltp;
    uint32                      header_size;

    uint64                      nPackets;
    uint32                      max_Prec;

    uint16                      dflt_param_c;
    uint16                      dflt_param_q;

    uint16                      slope_min, slope_max;
  } bwc_tile_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    uint64                      size;
    uint32                      tile_index;

    uint64                      X0, Y0, Z0, TS0;
    uint64                      X1, Y1, Z1, TS1;

  } bwc_tile_inf;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_tile_inf                info;
    bwc_tile_ctrl               control;

    bwc_parameter              *parameter;
    bwc_packet                **packet_sequence;
  } bwc_tile;
  /*==============================================================================================*/
  typedef struct
  {
    uint16                      CSsgc;
    uchar                       error_resilience;

    uint64                      tileSizeX,  tileSizeY;
    uint64                      tileSizeZ,  tileSizeTS;

    uint64                      nTiles;

    uint8                       precSizeX,  precSizeY;
    uint8                       precSizeZ,  precSizeTS;

    uint8                       cbX,        cbY;
    uint8                       cbZ,        cbTS;

    bwc_dwt_filter              KernelX,    KernelY;
    bwc_dwt_filter              KernelZ,    KernelTS;

    uint8                       decompX,    decompY;
    uint8                       decompZ,    decompTS;
    uint8                       nDecomp;

    uint32                      qt_exponent, qt_mantissa;
    uint8                       Qm;

    float                      *bitrate;

    uint8                       nLayers;
    uint8                       useLayer;

    uint8                       guard_bits;

    uint64                      headerSize;
    uint64                      codestreamSize;

    bwc_quant_st                quantization_style;
    bwc_prog_ord                progression;
  } bwc_gl_ctrl;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_gl_inf                  info;
    bwc_gl_ctrl                 control;
    bwc_span                    aux;
    bwc_span                    com;
  } bwc_header;
  /*==============================================================================================*/
  typedef struct
  {
    bwc_gl_inf                  info;
    bwc_gl_ctrl                 control;

    bwc_tile                   *tile;

    bwc_mode                    mode;
  } bwc_codec;

  /*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*\
  ||            ___  _  _ ___  _    _ ____    ____ _  _ _  _ ____ ___ _ ____ _  _ ____            ||
  ||            |__] |  | |__] |    | |       |___ |  | |\ | |     |  | |  | |\ | [__             ||
  ||            |    |__| |__] |___ | |___    |    |__| | \| |___  |  | |__| | \| ___]            ||
  ||                                                                                              ||
  \*<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>*/
  #ifdef __cplusplus
    extern "C" {
  #endif

  /*==============================================================================================*/
  bwc_stream*  bwc_init_stream            (void                         *const  inpbuf,
                                           void                         *const  outbuf,
                                           bwc_mode              const          mode);
  /*==============================================================================================*/
  uchar        bwc_set_com                (bwc_stream                   *const  stream,
                                           char                  const  *const  com, 
                                           uint16                const          size);
  /*==============================================================================================*/
  uchar        bwc_set_aux                (bwc_stream                   *const  stream,
                                           char                  const  *const  aux, 
                                           uint32                const          size);
  /*==============================================================================================*/
  bwc_codec*   bwc_alloc_coder            (uint64                const          nX,
                                           uint64                const          nY,
                                           uint64                const          nZ,
                                           uint64                const          nTS,
                                           uint8                 const          nPar,
                                           bwc_precision         const          prec);
  /*==============================================================================================*/
  bwc_codec*   bwc_alloc_decoder          ();
  /*==============================================================================================*/
  void         bwc_free_codec             (bwc_codec                    *const  codec);
  /*==============================================================================================*/
  void         bwc_set_error_resilience   (bwc_codec                    *const  codec);
  /*==============================================================================================*/
  void         bwc_set_decomp             (bwc_codec                    *const  codec,
                                           uint8                 const          decompX,
                                           uint8                 const          decompY,
                                           uint8                 const          decompZ,
                                           uint8                 const          decompTS);
  /*==============================================================================================*/
  void         bwc_set_precincts          (bwc_codec                    *const  codec,
                                           uint8                 const          pX,
                                           uint8                 const          pY,
                                           uint8                 const          pZ,
                                           uint8                 const          pTS);
  /*==============================================================================================*/
  void         bwc_set_codeblocks         (bwc_codec                    *const  codec,
                                           uint8                 const          cbX,
                                           uint8                 const          cbY,
                                           uint8                 const          cbZ,
                                           uint8                 const          cbTS);
  /*==============================================================================================*/
  void         bwc_set_qm                 (bwc_codec                    *const  codec,
                                           uint8                 const          Qm);
  /*==============================================================================================*/
  void         bwc_set_tiles              (bwc_codec                    *const  codec, 
                                           uint64                const          tilesX,
                                           uint64                const          tilesY,
                                           uint64                const          tilesZ,
                                           uint64                const          tilesTS,
                                           bwc_tile_instr        const          instr);
  /*==============================================================================================*/
  bwc_header*  bwc_open_header            (void                         *const  inpbuf);
  /*==============================================================================================*/
  void         bwc_close_header           (bwc_header                   *const  header);
  /*==============================================================================================*/
  uchar        bwc_create_compression     (bwc_codec                    *const  codec,
                                           bwc_stream                   *const  data,
                                           char                         *const  rate_control);
  /*==============================================================================================*/
  size_t       bwc_compress               (bwc_codec                    *const  codec,
                                           bwc_stream                   *const  data);
  /*==============================================================================================*/
  uchar        bwc_create_decompression   (bwc_codec                    *const  codec,
                                           bwc_stream                   *const  stream,
                                           uint8                 const          layer);
  /*==============================================================================================*/
  uchar        bwc_decompress             (bwc_codec                    *const  codec,
                                           bwc_stream                   *const  stream);

  #ifdef __cplusplus
    }
  #endif
#endif